{
    "mode": "router",
    "scouting": {
        "multicast": {
            "enabled": true,
            "autoconnect": [ "router" ]
        },
        "gossip": {
            "enabled": true
        }
    },
    "transport": {
        "link": {
            "tls": {
                "root_ca_certificate": "/etc/zenohd/certs/root-ca-cert.pem",
                "listen_private_key": "/etc/zenohd/certs/client-key.pem",
                "listen_certificate": "/etc/zenohd/certs/client-cert.pem",
                "enable_mtls": true
            }
        }
    },
    "timestamping": {
        "enabled": true
    },
    "routing": {
        "router": {
            "peers_failover_brokering": true
        },
        "peer": {
            "mode": "linkstate"
        }
    },
    "plugins": {
        "rest": {
            "http_port": 80,
            "__required__": true
        }
    }
}
