{
    "mode": "router",
    "scouting": {
        "multicast": {
            "enabled": true,
            "autoconnect": [ "router" ]
        },
        "gossip": {
            "enabled": true
        }
    },
    "timestamping": {
        "enabled": true
    },
    "routing": {
        "router": {
            "peers_failover_brokering": true
        },
        "peer": {
            "mode": "linkstate"
        }
    },
    "plugins": {
        "rest": {
            "http_port": 80,
            "__required__": true
        }
    }
}
